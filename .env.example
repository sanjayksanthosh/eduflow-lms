# ---------------------------------------------------------------------------
# EduFlow LMS - environment variables
# Copy to .env for local development, or set these in your hosting provider
# (Render: dashboard -> Environment, see render.yaml for the full list).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# MongoDB connection string.
# Local dev (replica set) :
#   mongodb://127.0.0.1:27017/eduflow?replicaSet=rs0&directConnection=true
# Production (MongoDB Atlas) : create a cluster, Database Access user, then
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eduflow?retryWrites=true&w=majority
DATABASE_URL="mongodb://127.0.0.1:27017/eduflow?replicaSet=rs0&directConnection=true"

# JWT secrets - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Comma-separated list of allowed browser origins.
# Production (same-origin hosting) should be: https://<your-app>.onrender.com
CLIENT_URL="http://localhost:5173"
API_URL="http://localhost:5000/api"
CORS_ORIGINS="http://localhost:5173"

# Cloudinary - production uploads. Optional locally (falls back to ./uploads).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""

# SMTP - optional. Used for password reset / notifications.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="EduFlow LMS <no-reply@eduflow.app>"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
